{
  "description": "Blocks shell commands that start dev servers in the background inside a devlanes project and points to devlanes exec",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "devlanes __agent-hook --agent codex; exit 0",
            "commandWindows": "cmd /d /c \"devlanes __agent-hook --agent codex & exit 0\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
