{
  "description": "Blocks shell commands that start dev servers in the background inside a devlanes project and points to devlanes exec",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "devlanes __agent-hook #|| exit 0\nexit 0",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
