      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/Templated_string"
        },
        "ignore": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from"
      ],
      "type": "object"
    },
    "TagColor": {
      "description": "Fixed terminal palette for tag color overrides.",
      "enum": [
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan",
        "white",
        "gray",
        "bright-red",
        "bright-green",
        "bright-yellow",
        "bright-blue",
        "bright-magenta",
        "bright-cyan"
      ],
      "type": "string"
    },
    "TagConfig": {
      "additionalProperties": false,
      "description": "Optional display overrides for a tag; services may also use undeclared tags.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/TagColor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal palette color; inferred by the resolver when omitted."
        },
        "description": {
          "description": "Human-readable description available to the TUI.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TaskAfter": {
      "enum": [
        "services"
      ],
      "type": "string"
    },
    "TaskConfig": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskAfter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Delay a create/start hook until all selected services are ready."
        },
        "confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Confirmation text; noninteractive clients must explicitly approve."
        },
        "cwd": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Working directory relative to the lane's worktree."
        },
        "env": {
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "default": {},
          "description": "Task-specific environment overrides.",
          "type": "object"
        },
        "fnox": {
          "anyOf": [
            {
              "$ref": "#/$defs/FnoxConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Task-specific fnox profile."
        },
        "interactive": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Require an attached terminal; incompatible with lifecycle hooks."
        },
        "profiles": {
          "description": "Profiles for which this lifecycle hook runs automatically.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "pty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Allocate a pseudoterminal instead of pipes."
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/Run"
            },
            {
              "type": "null"
            }
          ],
          "description": "Shell text or an argument vector. Mutually exclusive with run_script and steps."
        },
        "run_script": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunScript"
            },
            {
              "type": "null"
            }
          ],
          "description": "Script source and name, such as package.json#migrate or Makefile#build."
        },
        "steps": {
          "description": "Sequential task names or infra.setup/infra.teardown entries, always run explicitly.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_ConfigDuration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum run duration, for example 10m."
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskWhen"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lifecycle hook; omitted tasks run only on demand."
        }
      },
      "type": "object"
    },
    "TaskWhen": {
      "enum": [
        "lane.create",
        "lane.start",
        "lane.stop",
        "lane.clean"
      ],
      "type": "string"
    },
    "TcpReady": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "Templated_ConfigDuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfigDuration"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "Templated_Scalar": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scalar"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "Templated_boolean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "Templated_string": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "Templated_uint16": {
      "anyOf": [
        {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "Templated_uint32": {
      "anyOf": [
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    }
  },
  "$id": "https://devlanes.run/schema/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fully merged project configuration. Map order is declaration order.",
  "properties": {
    "fnox": {
      "anyOf": [
        {
          "$ref": "#/$defs/FnoxConfig"
        },
        {
          "type": "null"
        }
      ],
      "description": "Project-wide fnox profile for secrets resolved by the runtime."
    },
    "global_env": {
      "additionalProperties": {
        "$ref": "#/$defs/Templated_Scalar"
      },
      "default": {},
      "description": "Environment overrides for tasks and services, after derived DEVLANES values.",
      "type": "object"
    },
    "infra": {
      "$ref": "#/$defs/InfraConfig",
      "default": {
        "compose": null,
        "containers": {},
        "env": {},
        "exclude": null,
        "hidden": null,
        "hosts": {},
        "per_lane": null,
        "profiles": null,
        "project_name": null,
        "setup": {},
        "teardown": {}
      },
      "description": "Shared and per-lane containers, setup commands, and teardown commands."
    },
    "lanes": {
      "$ref": "#/$defs/LanesConfig",
      "default": {
        "block_size": null,
        "hosts_file": null,
        "matrix": null,
        "max": null,
        "new_worktrees": null,
        "primary": null,
        "removed_worktrees": null,
        "vars": {},
        "worktree_dir": null
      },
      "description": "Worktree registration, per-lane variables, and port-block policy."
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/ProfileConfig"
      },
      "default": {},
      "description": "Named service selectors with optional environment and infrastructure overrides.",
      "type": "object"
    },
    "project": {
      "description": "Project identity shared by every worktree; lowercase letters, digits, dots, underscores, and dashes.",
      "type": "string"
    },
    "services": {
      "additionalProperties": {
        "$ref": "#/$defs/ServiceConfig"
      },
      "default": {},
      "description": "Long-running processes started together after infrastructure and before-service tasks.",
      "type": "object"
    },
    "tags": {
      "additionalProperties": {
        "$ref": "#/$defs/TagConfig"
      },
      "default": {},
      "description": "Tag settings. Units are colored by their first tag; colors are inferred from common tag names (api, web, worker, db, ...) when not set here.",
      "type": "object"
    },
    "tasks": {
      "additionalProperties": {
        "$ref": "#/$defs/TaskConfig"
      },
      "default": {},
      "description": "One-shot commands; lifecycle hooks execute in declaration order.",
      "type": "object"
    },
    "templates": {
      "additionalProperties": {
        "$ref": "#/$defs/ServiceConfig"
      },
      "default": {},
      "description": "Reusable service settings, inherited with extends after local overrides are merged.",
      "type": "object"
    }
  },
  "title": "ProjectConfig",
  "type": "object"
}
