          "description": "Platform: node, bun, deno, python or rust; detected from project files when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "preset": {
          "description": "Registered framework preset; options use a sibling key with this name.",
          "enum": [
            "vite",
            "next",
            "wrangler",
            "tauri"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "pty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Use a pseudoterminal; defaults to true."
        },
        "ready": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadyConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Readiness policy; defaults to TCP with hosts, otherwise started."
        },
        "replicas": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_uint16"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of instances; replica.index starts at one. Defaults to one."
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/Run"
            },
            {
              "type": "null"
            }
          ],
          "description": "Shell command or argv; exactly one of run and run_script is required after inheritance."
        },
        "run_script": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunScript"
            },
            {
              "type": "null"
            }
          ],
          "description": "Script file and name, in shorthand or object form."
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "#/$defs/StopConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stop signal and grace period before killing the process tree."
        },
        "sync": {
          "description": "Folders copied to stable local or remote-client paths.",
          "items": {
            "$ref": "#/$defs/SyncConfig"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tags": {
          "description": "Tags used by +tag profile selectors.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tauri": {
          "allOf": [
            {
              "type": "object"
            },
            {
              "$ref": "#/$defs/InjectedPresetOptions3"
            }
          ]
        },
        "vite": {
          "allOf": [
            {
              "type": "object"
            },
            {
              "$ref": "#/$defs/InjectedPresetOptions0"
            }
          ]
        },
        "wrangler": {
          "allOf": [
            {
              "type": "object"
            },
            {
              "$ref": "#/$defs/InjectedPresetOptions2"
            }
          ]
        }
      },
      "type": "object"
    },
    "Started": {
      "enum": [
        "started"
      ],
      "type": "string"
    },
    "StopConfig": {
      "additionalProperties": false,
      "properties": {
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_ConfigDuration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
