      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "format": "double",
          "type": "number"
        }
      ],
      "description": "A scalar suitable for environment variables and free-form lane variables."
    },
