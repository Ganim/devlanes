          "type": "object"
        },
        "env": {
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "default": {},
          "description": "Variables for Compose interpolation, separate from process global_env.",
          "type": "object"
        },
        "exclude": {
          "description": "Compose services never started by devlanes.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "hidden": {
          "description": "Containers whose ports must not be mirrored to remote clients.",
