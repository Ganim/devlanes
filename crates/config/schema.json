      "additionalProperties": false,
      "description": "Service settings after typed local and template merging.",
      "properties": {
        "autostart": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Start by default unless explicitly selected; defaults to true."
        },
        "cwd": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Working directory relative to the lane worktree."
        },
        "env": {
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "default": {},
          "description": "Service-specific environment overrides, above global_env.",
          "type": "object"
        },
        "extends": {
          "description": "Template name; resolved after devlanes.local.yaml is merged.",
          "type": [
            "string",
            "null"
          ]
        },
        "fnox": {
          "anyOf": [
            {
              "$ref": "#/$defs/FnoxConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Override the project fnox profile for this service."
        },
        "hidden": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prevent remote port mirroring; defaults to false."
        },
        "hosts": {
          "description": "HTTP hosts, wildcard hosts, and routes to named ports.",
