    "InjectedPresetOptions0": {
      "additionalProperties": false,
      "description": "Options under the service's `vite:` key.",
      "properties": {
        "args": {
          "description": "Extra arguments appended after the preset's flags.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "title": "ViteOptions",
      "type": "object"
    },
    "InjectedPresetOptions1": {
      "additionalProperties": false,
      "description": "Options under the service's `next:` key.",
      "properties": {
        "args": {
          "description": "Extra arguments appended after the preset's flags.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "title": "NextOptions",
      "type": "object"
    },
    "InjectedPresetOptions2": {
      "additionalProperties": false,
      "description": "Options under the service's `wrangler:` key.",
      "properties": {
        "args": {
          "description": "Extra arguments appended after the preset's flags.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "isolate_registry": {
          "description": "Give each lane its own dev registry through `WRANGLER_REGISTRY_PATH`.\nDefault: true.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "vars": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Worker variables, passed as `--var KEY:VALUE`. Numbers and booleans are\naccepted because config scalars evaluate to them; wrangler sees strings.",
          "type": "object"
        }
      },
      "title": "WranglerOptions",
      "type": "object"
    },
    "InjectedPresetOptions3": {
      "additionalProperties": false,
      "description": "Options under the service's `tauri:` key, after expression evaluation.",
      "properties": {
        "before_dev_command": {
          "description": "`build.beforeDevCommand` override. Set it to an empty string when the\nfrontend runs as its own devlanes service; otherwise every replica\nstarts its own frontend on the port from `tauri.conf.json`.",
          "type": [
            "string",
            "null"
          ]
        },
        "dev_url": {
          "description": "`build.devUrl`, usually another service's `url`.",
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "description": "Bundle identifier for this lane and replica. Required; it must differ per\nlane and replica, for example\n`com.acme.app.dev${{ '' if lane.index == 0 else '.lane' ~ lane.index }}.client${{ replica.index }}`.",
          "type": [
            "string",
            "null"
          ]
        },
        "product_name": {
          "description": "`productName` override, shown in the dock and window menus.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "TauriOptions",
      "type": "object"
    },
