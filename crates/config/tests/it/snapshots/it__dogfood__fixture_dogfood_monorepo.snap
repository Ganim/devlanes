    "pages-worker": {
      "extends": "wrangler-worker",
      "run_script": "workers/pages/package.json#dev",
      "platform": "node",
      "preset": "wrangler",
      "hosts": [
        "pages.${{ lane.domain }}",
        "link.${{ lane.domain }}",
        "${{ lane.pages_domain }}",
        "*.${{ lane.pages_domain }}",
        "*.${{ lane.test_domain }}"
      ],
      "tags": [
        "worker",
        "essential"
      ],
      "ready": {
        "tcp": null,
        "http": {
          "path": "/-/health",
          "status": null,
          "timeout": "90000ms"
        },
        "log": null,
        "cmd": null,
        "timeout": null
      },
      "env": {
        "ACME_PAGES_WORKER_PORT": "${{ self.port }}",
        "ACME_PAGES_SERVER_PORT": "${{ svc.pages_server.port }}"
      }
    },
    "mcp-worker": {
      "extends": "wrangler-worker",
      "run_script": "workers/mcp/package.json#dev",
      "platform": "node",
      "preset": "wrangler",
      "hosts": [
        "mcp.${{ lane.domain }}"
      ],
      "tags": [
        "worker"
      ],
      "ready": "started",
      "env": {
        "ACME_MCP_PORT": "${{ self.port }}"
      }
    },
    "sms-worker": {
      "extends": "wrangler-worker",
      "run_script": "workers/sms/package.json#dev",
      "platform": "node",
      "preset": "wrangler",
      "hosts": [
        "sms-worker.${{ lane.domain }}"
      ],
      "tags": [
        "worker",
        "messaging"
      ],
      "ready": {
        "tcp": null,
        "http": {
          "path": "/-/health",
          "status": null,
          "timeout": "90000ms"
        },
        "log": null,
        "cmd": null,
        "timeout": null
      }
    },
    "sms-stub": {
      "run_script": "servers/sms-stub/package.json#dev",
      "platform": "node",
      "hosts": [
        "sms-stub.${{ lane.domain }}"
      ],
      "tags": [
        "stub"
      ],
      "ready": {
        "tcp": null,
        "http": {
          "path": "/health",
          "status": null,
          "timeout": null
        },
        "log": null,
        "cmd": null,
        "timeout": null
      },
      "autostart": false,
      "env": {
        "ACME_SMS_STUB_PORT": "${{ self.port }}"
      }
    }
  },
  "profiles": {
    "default": [
      "+essential"
    ],
    "servers": [
      "+api",
      "+queue"
    ],
    "everything": {
      "include": [
        "*"
      ],
      "exclude": [
        "+stub"
      ],
      "infra": null,
      "env": {},
      "run_scripts": {}
    },
    "stage-web": {
      "include": [
        "+stage-web"
      ],
      "exclude": null,
      "infra": false,
      "env": {
        "ACME_USE_STAGE_APIS": "1"
      },
      "run_scripts": {}
    },
    "e2e": {
      "include": [
        "+api",
        "+queue",
        "+web",
        "api-gateway",
        "pages-worker",
        "mcp-worker"
      ],
      "exclude": [
        "docs"
      ],
      "infra": null,
      "env": {},
      "run_scripts": {
        "dev": "start"
      }
    }
