---
source: "../tests/it/main.rs"
expression: config
---
{
  "project": "acme-desktop",
  "templates": {
    "worker": {
      "platform": "node",
      "preset": "wrangler",
      "tags": [
        "backend"
      ],
      "ready": {
        "tcp": null,
        "http": {
          "path": "/health",
          "status": null,
          "timeout": "180000ms"
        },
        "log": null,
        "cmd": null,
        "timeout": null
      }
    }
  },
  "lanes": {
    "primary": "main",
    "new_worktrees": null,
    "removed_worktrees": null,
    "worktree_dir": null,
    "block_size": null,
    "max": null,
    "hosts_file": "always",
    "vars": {},
    "matrix": null
  },
  "infra": {
    "compose": null,
    "project_name": null,
    "exclude": null,
    "per_lane": null,
    "profiles": null,
    "env": {},
    "hosts": {},
    "hidden": null,
    "containers": {
      "policy": {
        "image": "ghcr.io/cerbos/cerbos:0.40.0",
        "command": [
          "server",
          "--config=/policies/config.yaml"
        ],
        "volumes": [
          "./policies:/policies:ro"
        ],
        "ports": {
          "http": 3592,
          "grpc": 3593
        },
        "per_lane": true,
        "env": {},
        "ready": null
      }
    },
    "setup": {},
    "teardown": {}
  },
  "fnox": null,
  "global_env": {
    "POLICY_URL": "http://127.0.0.1:${{ infra.policy.ports.http }}"
  },
  "tasks": {
    "install": {
      "run": "pnpm install --frozen-lockfile",
      "run_script": null,
      "cwd": null,
      "env": {},
      "fnox": null,
      "when": "lane.create",
      "after": null,
      "profiles": null,
      "steps": null,
      "confirm": null,
      "interactive": null,
      "timeout": null,
      "pty": null
    },
    "migrate": {
      "run": null,
      "run_script": "package.json#migrate-local",
      "cwd": null,
      "env": {},
      "fnox": null,
      "when": "lane.start",
      "after": null,
      "profiles": [
        "default",
        "backend"
      ],
      "steps": null,
      "confirm": null,
      "interactive": null,
      "timeout": null,
      "pty": null
    }
  },
  "services": {
    "identity": {
      "extends": "worker",
      "run_script": "workers/identity/package.json#dev",
      "platform": "node",
      "preset": "wrangler",
      "hosts": [
        "identity.${{ lane.domain }}"
      ],
      "tags": [
        "backend"
      ],
      "ready": {
        "tcp": null,
        "http": {
          "path": "/health",
          "status": null,
          "timeout": "180000ms"
        },
        "log": null,
        "cmd": null,
        "timeout": null
      }
    },
    "chat": {
      "extends": "worker",
      "run_script": "workers/chat/package.json#dev",
      "platform": "node",
      "preset": "wrangler",
      "hosts": [
        "chat.${{ lane.domain }}"
      ],
      "tags": [
        "backend"
      ],
      "ready": {
        "tcp": null,
        "http": {
          "path": "/health",
          "status": null,
          "timeout": "180000ms"
        },
        "log": null,
        "cmd": null,
        "timeout": null
      },
      "wrangler": {
        "vars": {
          "IDENTITY_URL": "${{ svc.identity.url }}"
        },
        "args": [
          "--persist-to",
          ".local-state"
        ]
      }
    },
    "desktop-web": {
      "run_script": "apps/web/package.json#dev",
      "platform": "node",
      "preset": "vite",
      "tags": [
        "desktop"
      ],
      "env": {
        "API_URL": "${{ svc.chat.public_url }}"
      }
    },
    "desktop": {
      "run_script": "apps/desktop/package.json#dev",
      "platform": "node",
      "preset": "tauri",
      "tags": [
        "desktop"
      ],
      "replicas": 2,
      "tauri": {
        "identifier": "io.example.desktop.lane${{ lane.index }}.client${{ replica.index }}",
        "dev_url": "${{ svc.desktop_web.url }}"
      }
    },
    "browser-extension": {
      "run_script": "apps/extension/package.json#dev",
      "tags": [
        "extension"
      ],
      "sync": [
        {
          "from": "apps/extension/.output/chrome-mv3",
          "to": null,
          "ignore": [
            "*.map"
          ]
        }
      ]
    },
    "simulator": {
      "run": "npx serve-sim --port ${{ self.port }}",
      "hosts": [
        "sim.${{ lane.domain }}"
      ],
      "autostart": false
    }
  },
  "profiles": {
    "default": [
      "+backend",
      "+desktop"
    ],
    "backend": [
      "+backend"
    ],
    "attach": {
      "include": [
        "+desktop"
      ],
      "exclude": null,
      "infra": false,
      "env": {
        "API_URL": "${{ lanes.main.svc.chat.public_url }}"
      },
      "run_scripts": {}
    }
  }
}
