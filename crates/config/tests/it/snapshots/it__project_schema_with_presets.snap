---
source: crates/config/tests/it/main.rs
expression: registered
---
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "description": "Project identity shared by every worktree; lowercase letters, digits, dots, underscores, and dashes."
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ServiceConfig"
      },
      "description": "Reusable service settings, inherited with extends after local overrides are merged.",
      "default": {}
    },
    "lanes": {
      "$ref": "#/$defs/LanesConfig",
      "description": "Worktree registration, per-lane variables, and port-block policy.",
      "default": {
        "primary": null,
        "new_worktrees": null,
        "removed_worktrees": null,
        "worktree_dir": null,
        "block_size": null,
        "max": null,
        "hosts_file": null,
        "vars": {},
        "matrix": null
      }
    },
    "infra": {
      "$ref": "#/$defs/InfraConfig",
      "description": "Shared and per-lane containers, setup commands, and teardown commands.",
      "default": {
        "compose": null,
        "project_name": null,
        "exclude": null,
        "per_lane": null,
        "profiles": null,
        "env": {},
        "hosts": {},
        "hidden": null,
        "containers": {},
        "setup": {},
        "teardown": {}
      }
    },
    "fnox": {
      "anyOf": [
        {
          "$ref": "#/$defs/FnoxConfig"
        },
        {
          "type": "null"
        }
      ],
      "description": "Project-wide fnox profile for secrets resolved by the runtime."
    },
    "global_env": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Templated_Scalar"
      },
      "description": "Environment overrides for tasks and services, after derived DEVLANES values.",
      "default": {}
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/TaskConfig"
      },
      "description": "One-shot commands; lifecycle hooks execute in declaration order.",
      "default": {}
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ServiceConfig"
      },
      "description": "Long-running processes started together after infrastructure and before-service tasks.",
      "default": {}
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProfileConfig"
      },
      "description": "Named service selectors with optional environment and infrastructure overrides.",
      "default": {}
    }
  },
  "$id": "https://devlanes.run/schema/v1.json",
  "description": "Fully merged project configuration. Map order is declaration order.",
  "title": "ProjectConfig",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ServiceConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {
          "type": [
            "string",
            "null"
          ],
          "description": "Template name; resolved after devlanes.local.yaml is merged."
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/Run"
            },
            {
              "type": "null"
            }
          ],
          "description": "Shell command or argv; exactly one of run and run_script is required after inheritance."
        },
        "run_script": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunScript"
            },
            {
              "type": "null"
            }
          ],
          "description": "Script file and name, in shorthand or object form."
        },
        "cwd": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Working directory relative to the lane worktree."
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "description": "Platform: node, bun, deno, python or rust; detected from project files when omitted."
        },
        "preset": {
          "type": [
            "string",
            "null"
          ],
          "description": "Registered framework preset; options use a sibling key with this name.",
          "enum": [
            "vite",
            "next",
            "wrangler",
            "tauri"
          ]
        },
        "hosts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/HostConfig"
          },
          "description": "HTTP hosts, wildcard hosts, and routes to named ports."
        },
        "tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Tags used by +tag profile selectors."
        },
        "ready": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadyConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Readiness policy; defaults to TCP with hosts, otherwise started."
        },
        "pty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Use a pseudoterminal; defaults to true."
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "#/$defs/StopConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stop signal and grace period before killing the process tree."
        },
        "hidden": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prevent remote port mirroring; defaults to false."
        },
        "autostart": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Start by default unless explicitly selected; defaults to true."
        },
        "fnox": {
          "anyOf": [
            {
              "$ref": "#/$defs/FnoxConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Override the project fnox profile for this service."
        },
        "sync": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/SyncConfig"
          },
          "description": "Folders copied to stable local or remote-client paths."
        },
        "replicas": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_uint16"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of instances; replica.index starts at one. Defaults to one."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "description": "Service-specific environment overrides, above global_env.",
          "default": {}
        },
        "vite": {
          "allOf": [
            {
              "type": "object"
            },
            {
              "$ref": "#/$defs/InjectedPresetOptions0"
            }
          ]
        },
        "next": {
          "allOf": [
            {
              "type": "object"
            },
            {
              "$ref": "#/$defs/InjectedPresetOptions1"
            }
          ]
        },
        "wrangler": {
          "allOf": [
            {
              "type": "object"
            },
            {
              "$ref": "#/$defs/InjectedPresetOptions2"
            }
          ]
        },
        "tauri": {
          "allOf": [
            {
              "type": "object"
            },
            {
              "$ref": "#/$defs/InjectedPresetOptions3"
            }
          ]
        }
      },
      "description": "Service settings after typed local and template merging."
    },
    "Run": {
      "anyOf": [
        {
          "$ref": "#/$defs/Templated_string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Templated_string"
          }
        }
      ],
      "description": "Shell text runs in a shell; argv is passed directly to the executable."
    },
    "Templated_string": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "RunScript": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/ScriptSource"
        }
      ]
    },
    "ScriptSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "name"
      ]
    },
    "HostConfig": {
      "anyOf": [
        {
          "$ref": "#/$defs/Templated_string"
        },
        {
          "$ref": "#/$defs/HostRoute"
        }
      ]
    },
    "HostRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "$ref": "#/$defs/Templated_string"
        },
        "port": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_header": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostHeader"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "host"
      ]
    },
    "Templated_boolean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "HostHeader": {
      "type": "string",
      "enum": [
        "preserve",
        "upstream"
      ]
    },
    "ReadyConfig": {
      "anyOf": [
        {
          "$ref": "#/$defs/Started"
        },
        {
          "$ref": "#/$defs/ReadyCheck"
        }
      ]
    },
    "Started": {
      "type": "string",
      "enum": [
        "started"
      ]
    },
    "ReadyCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/TcpReady"
            },
            {
              "type": "null"
            }
          ]
        },
        "http": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpReady"
            },
            {
              "type": "null"
            }
          ]
        },
        "log": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cmd": {
          "anyOf": [
            {
              "$ref": "#/$defs/Run"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_ConfigDuration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Exactly one readiness mechanism is accepted by semantic validation."
    },
    "TcpReady": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "HttpReady": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_uint16"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_ConfigDuration"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Templated_uint16": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "Templated_ConfigDuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfigDuration"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "ConfigDuration": {
      "type": "string",
      "description": "A duration written with `ms`, `s`, `m`, `h`, or `d` units."
    },
    "StopConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_ConfigDuration"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "FnoxConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SyncConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/Templated_string"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "from"
      ]
    },
    "Templated_Scalar": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scalar"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "Scalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        }
      ],
      "description": "A scalar suitable for environment variables and free-form lane variables."
    },
    "LanesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": [
            "string",
            "null"
          ],
          "description": "Branch assigned lane zero; defaults to the remote default branch, main, or master."
        },
        "new_worktrees": {
          "anyOf": [
            {
              "$ref": "#/$defs/NewWorktrees"
            },
            {
              "type": "null"
            }
          ],
          "description": "Action for newly discovered worktrees; defaults to register."
        },
        "removed_worktrees": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemovedWorktrees"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stop processes or also clean lane data when a worktree disappears."
        },
        "worktree_dir": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Directory for newly created worktrees, relative to the project."
        },
        "block_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_uint16"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fixed port-block capacity; otherwise allocated with fifty percent headroom."
        },
        "max": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_uint32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum assigned lanes; existing lanes are retained if this is lowered."
        },
        "hosts_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostsFile"
            },
            {
              "type": "null"
            }
          ],
          "description": "Project-specific host-file hint, overriding the user's policy."
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "description": "Scalar lane values available through the lane expression namespace.",
          "default": {}
        },
        "matrix": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/Templated_Scalar"
            }
          },
          "description": "Explicit lane values; entry N describes lane N. Mutually exclusive with vars."
        }
      }
    },
    "NewWorktrees": {
      "type": "string",
      "enum": [
        "register",
        "setup",
        "start"
      ]
    },
    "RemovedWorktrees": {
      "type": "string",
      "enum": [
        "stop",
        "clean"
      ]
    },
    "Templated_uint32": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "HostsFile": {
      "type": "string",
      "enum": [
        "auto",
        "never",
        "always"
      ]
    },
    "InfraConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compose": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeFiles"
            },
            {
              "type": "null"
            }
          ],
          "description": "Compose file or ordered list of Compose files."
        },
        "project_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Shared Compose project name; defaults to Compose's own name."
        },
        "exclude": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Compose services never started by devlanes."
        },
        "per_lane": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Compose services instantiated separately in each lane."
        },
        "profiles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Compose profiles enabled when resolving and starting infrastructure."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "description": "Variables for Compose interpolation, separate from process global_env.",
          "default": {}
        },
        "hosts": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/HostConfig"
            }
          },
          "description": "Container name to HTTP proxy route declarations.",
          "default": {}
        },
        "hidden": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Containers whose ports must not be mirrored to remote clients."
        },
        "containers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ContainerConfig"
          },
          "description": "Plain Docker containers managed alongside Compose services.",
          "default": {}
        },
        "setup": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/InfraCommand"
          },
          "description": "Named commands run once per lane after containers become healthy.",
          "default": {}
        },
        "teardown": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/InfraCommand"
          },
          "description": "Named cleanup commands run when a lane is explicitly cleaned.",
          "default": {}
        }
      }
    },
    "ComposeFiles": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "ContainerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/Run"
            },
            {
              "type": "null"
            }
          ]
        },
        "volumes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Templated_string"
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Templated_uint16"
          },
          "default": {}
        },
        "per_lane": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "default": {}
        },
        "ready": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadyConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InfraCommand": {
      "anyOf": [
        {
          "$ref": "#/$defs/InfraCommandOptions"
        },
        {
          "$ref": "#/$defs/Run"
        }
      ]
    },
    "InfraCommandOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/Run"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_script": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "container": {
          "type": [
            "string",
            "null"
          ]
        },
        "ignore_errors": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "default": {}
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_ConfigDuration"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TaskConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/Run"
            },
            {
              "type": "null"
            }
          ],
          "description": "Shell text or an argument vector. Mutually exclusive with run_script and steps."
        },
        "run_script": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunScript"
            },
            {
              "type": "null"
            }
          ],
          "description": "Script source and name, such as package.json#migrate or Makefile#build."
        },
        "cwd": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Working directory relative to the lane's worktree."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "description": "Task-specific environment overrides.",
          "default": {}
        },
        "fnox": {
          "anyOf": [
            {
              "$ref": "#/$defs/FnoxConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Task-specific fnox profile."
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskWhen"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lifecycle hook; omitted tasks run only on demand."
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskAfter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Delay a create/start hook until all selected services are ready."
        },
        "profiles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Profiles for which this lifecycle hook runs automatically."
        },
        "steps": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Sequential task names or infra.setup/infra.teardown entries, always run explicitly."
        },
        "confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Confirmation text; noninteractive clients must explicitly approve."
        },
        "interactive": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Require an attached terminal; incompatible with lifecycle hooks."
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_ConfigDuration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum run duration, for example 10m."
        },
        "pty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Allocate a pseudoterminal instead of pipes."
        }
      }
    },
    "TaskWhen": {
      "type": "string",
      "enum": [
        "lane.create",
        "lane.start",
        "lane.stop",
        "lane.clean"
      ]
    },
    "TaskAfter": {
      "type": "string",
      "enum": [
        "services"
      ]
    },
    "ProfileConfig": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "$ref": "#/$defs/ProfileOptions"
        }
      ]
    },
    "ProfileOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Service names, globs, and +tag selectors included by this profile."
        },
        "exclude": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Selectors removed from the included service set."
        },
        "infra": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templated_boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set false to skip containers and infra setup."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Templated_Scalar"
          },
          "description": "Profile environment overrides, applied above service environment values.",
          "default": {}
        },
        "run_scripts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": "Remap service script names once, such as dev to start; source files stay unchanged.",
          "default": {}
        }
      }
    },
    "InjectedPresetOptions0": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments appended after the preset's flags."
        }
      },
      "description": "Options under the service's `vite:` key.",
      "title": "ViteOptions"
    },
    "InjectedPresetOptions1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments appended after the preset's flags."
        }
      },
      "description": "Options under the service's `next:` key.",
      "title": "NextOptions"
    },
    "InjectedPresetOptions2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Worker variables, passed as `--var KEY:VALUE`. Numbers and booleans are\naccepted because config scalars evaluate to them; wrangler sees strings."
        },
        "args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments appended after the preset's flags."
        },
        "isolate_registry": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Give each lane its own dev registry through `WRANGLER_REGISTRY_PATH`.\nDefault: true."
        }
      },
      "description": "Options under the service's `wrangler:` key.",
      "title": "WranglerOptions"
    },
    "InjectedPresetOptions3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": [
            "string",
            "null"
          ],
          "description": "Bundle identifier for this lane and replica. Required; it must differ per\nlane and replica, for example\n`com.acme.app.dev${{ '' if lane.index == 0 else '.lane' ~ lane.index }}.client${{ replica.index }}`."
        },
        "product_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "`productName` override, shown in the dock and window menus."
        },
        "dev_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "`build.devUrl`, usually another service's `url`."
        },
        "before_dev_command": {
          "type": [
            "string",
            "null"
          ],
          "description": "`build.beforeDevCommand` override. Set it to an empty string when the\nfrontend runs as its own devlanes service; otherwise every replica\nstarts its own frontend on the port from `tauri.conf.json`."
        }
      },
      "description": "Options under the service's `tauri:` key, after expression evaluation.",
      "title": "TauriOptions"
    }
  }
}
