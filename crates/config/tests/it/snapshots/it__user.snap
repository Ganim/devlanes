{
  "hostnames": {
    "resolver": "localhost",
    "hosts_file": "auto",
    "tld": null,
    "base_domain": null,
    "dns_provider": null
  },
  "ports": {
    "range": "20000-32767"
  },
  "tls": {
    "ca": "devlanes",
    "trust": [
      "system",
      "firefox"
    ]
  },
