  },
  "state": {
    "max_size": "536870912B"
  },
  "startup": {
    "mode": "adaptive",
    "initial": 2,
    "max": 8,
    "target_cpu": "75%",
    "settle_cpu": "10%",
    "slot_timeout": "20000ms"
  },
  "terminal": {
    "app": "ghostty",
    "progress": "auto"
  },
  "updates": {
    "check": true
  }
