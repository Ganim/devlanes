{
  "$comment": "Generated by bins/devlanes/build.rs from crates/config; do not edit.",
  "$defs": {
    "ByteSize": {
      "description": "A byte count with decimal or binary size units.",
      "type": "string"
    },
    "CaKind": {
      "enum": [
        "devlanes",
        "mkcert"
      ],
      "type": "string"
    },
    "CloudflareDns": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/$defs/Templated_string"
        }
      },
      "required": [
        "token"
      ],
      "type": "object"
    },
    "ConfigDuration": {
      "description": "A duration written with `ms`, `s`, `m`, `h`, or `d` units.",
      "type": "string"
    },
    "DnsProvider": {
      "additionalProperties": false,
      "properties": {
        "cloudflare": {
          "$ref": "#/$defs/CloudflareDns"
        }
      },
      "required": [
        "cloudflare"
      ],
      "type": "object"
    },
    "HostnamesConfig": {
      "additionalProperties": false,
      "properties": {
        "base_domain": {
          "default": null,
          "description": "Reserved public-resolver base domain; not supported yet.",
          "type": [
            "string",
            "null"
          ]
        },
        "dns_provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/DnsProvider"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reserved DNS-01 provider settings; not supported yet."
        },
        "hosts_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostsFile"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether exact hostnames should also be written to the system hosts file."
        },
        "resolver": {
          "$ref": "#/$defs/Resolver",
          "default": "localhost",
          "description": "localhost or resolver in v1; public parses but is not supported yet."
        },
        "tld": {
          "default": null,
          "description": "Custom top-level domain for the embedded DNS strategy.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HostsFile": {
      "enum": [
        "auto",
        "never",
        "always"
      ],
      "type": "string"
    },
    "LogRetention": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "default": 7,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_size": {
          "$ref": "#/$defs/ByteSize",
          "default": "5368709120B"
        }
      },
      "type": "object"
    },
    "LogsConfig": {
      "additionalProperties": false,
      "properties": {
        "retention": {
          "$ref": "#/$defs/LogRetention",
          "default": {
            "days": 7,
            "max_size": "5368709120B"
          }
        }
      },
      "type": "object"
    },
    "MetricsConfig": {
      "additionalProperties": false,
      "properties": {
        "retention": {
          "$ref": "#/$defs/ConfigDuration",
          "default": "2592000000ms"
        }
      },
      "type": "object"
    },
    "Percent": {
      "description": "A percentage with a `%` suffix, such as `75%` or `12.5%`.",
      "type": "string"
    },
    "PortsConfig": {
      "additionalProperties": false,
      "properties": {
        "range": {
          "default": "20000-32767",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ProxyConfig": {
      "additionalProperties": false,
      "properties": {
        "http_port": {
          "default": 80,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "https_port": {
          "default": 443,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "lan": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Resolver": {
      "enum": [
        "localhost",
        "hosts_file",
        "resolver",
        "public"
      ],
      "type": "string"
    },
    "StartupConfig": {
      "additionalProperties": false,
      "description": "Startup pacing. Machine settings, so they live in user config only.",
      "properties": {
        "initial": {
          "default": null,
          "description": "Adaptive starting window; default CPU cores / 4, at least 2, at most `max`.",
          "format": "uint32",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "max": {
          "default": null,
          "description": "Largest window (the fixed window in `fixed` mode); default CPU cores.",
          "format": "uint32",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/StartupMode",
          "default": "fixed",
          "description": "`adaptive`, `fixed` or `all`; default `fixed`."
        },
        "settle_cpu": {
          "$ref": "#/$defs/Percent",
          "default": "10%",
          "description": "A `ready: started` service has finished starting once its process tree\nstays below this share of one core for 2 s; default 10%."
        },
        "slot_timeout": {
          "$ref": "#/$defs/ConfigDuration",
          "default": "20000ms",
          "description": "A start slot is given back after this even if the service is not ready,\nso services waiting on each other cannot block the queue; default 20s."
        },
        "target_cpu": {
          "$ref": "#/$defs/Percent",
          "default": "75%",
          "description": "Adaptive mode grows the window while system CPU stays below this; default 75%."
        }
      },
      "type": "object"
    },
    "StartupMode": {
      "description": "How the start gate sizes its window.",
      "oneOf": [
        {
          "const": "adaptive",
          "description": "Grow the window while CPU and memory allow, shrink it under pressure.",
          "type": "string"
        },
        {
          "const": "fixed",
          "description": "Always `max` starts at a time.",
          "type": "string"
        },
        {
          "const": "all",
          "description": "No pacing: every service starts at once.",
          "type": "string"
        }
      ]
    },
    "Templated_string": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "description": "A literal value or a `${{ ... }}` template, checked against `T` after evaluation."
    },
    "Terminal": {
      "enum": [
        "iterm2",
        "ghostty",
        "wezterm",
        "kitty",
        "terminal"
      ],
      "type": "string"
    },
    "TlsConfig": {
      "additionalProperties": false,
      "properties": {
        "ca": {
          "$ref": "#/$defs/CaKind",
          "default": "devlanes"
        },
        "trust": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TrustTarget"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "TrustTarget": {
      "enum": [
        "system",
        "firefox",
        "chrome",
        "ios-simulator",
        "android-emulator"
      ],
      "type": "string"
    }
  },
  "$id": "https://devlanes.run/schema/user-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Per-user machine settings, separate from project configuration.",
  "properties": {
    "hostnames": {
      "$ref": "#/$defs/HostnamesConfig",
      "default": {
        "base_domain": null,
        "dns_provider": null,
        "hosts_file": null,
        "resolver": "localhost",
        "tld": null
      },
      "description": "Hostname resolution strategy and optional hosts-file policy."
    },
    "logs": {
      "$ref": "#/$defs/LogsConfig",
      "default": {
        "retention": {
          "days": 7,
          "max_size": "5368709120B"
        }
      },
      "description": "Disk retention for service output."
    },
    "metrics": {
      "$ref": "#/$defs/MetricsConfig",
      "default": {
        "retention": "2592000000ms"
      },
      "description": "Retention for monitor aggregates."
    },
    "ports": {
      "$ref": "#/$defs/PortsConfig",
      "default": {
        "range": "20000-32767"
      },
      "description": "Machine-wide pool shared by all project lane blocks."
    },
    "proxy": {
      "$ref": "#/$defs/ProxyConfig",
      "default": {
        "http_port": 80,
        "https_port": 443,
        "lan": false
      },
      "description": "HTTP/HTTPS listening ports and LAN access policy."
    },
    "startup": {
      "$ref": "#/$defs/StartupConfig",
      "default": {
        "initial": null,
        "max": null,
        "mode": "fixed",
        "settle_cpu": "10%",
        "slot_timeout": "20000ms",
        "target_cpu": "75%"
      },
      "description": "How many services start at once, across all lanes and projects."
    },
    "terminal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Terminal"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Terminal application used by open-in-terminal actions."
    },
    "tls": {
      "$ref": "#/$defs/TlsConfig",
      "default": {
        "ca": "devlanes",
        "trust": []
      },
      "description": "Certificate authority and explicitly requested trust targets."
    }
  },
  "title": "UserConfig",
  "type": "object"
}
