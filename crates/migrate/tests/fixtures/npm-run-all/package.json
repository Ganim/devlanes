{
  "name": "acme",
  "private": true,
  "scripts": {
    "start": "npm-run-all clean build:css --parallel watch:* \"serve -- --open\"",
    "clean": "rimraf dist",
    "build:css": "postcss src/app.css -o dist/app.css",
    "watch:js": "esbuild src/index.ts --bundle --outdir=dist --watch",
    "watch:css": "postcss src/app.css -o dist/app.css --watch",
    "serve": "http-server dist -p 8080"
  }
}
