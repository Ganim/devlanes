{
  "apps": [
    {
      "name": "api",
      "script": "./api/server.js",
      "args": "--port 4000",
      "node_args": "--inspect",
      "env": { "NODE_ENV": "development", "WEB_URL": "http://localhost:5173" },
      "env_production": { "NODE_ENV": "production" },
      "instances": 2,
      "exec_mode": "cluster",
      "watch": true,
      "kill_timeout": 3000,
      "out_file": "./logs/api.out.log",
      "max_memory_restart": "300M"
    },
    {
      "name": "web",
      "script": "npm",
      "args": ["run", "dev", "--", "--port", "5173"],
      "cwd": "web",
      "wait_ready": true
    },
    {
      "script": "workers/mailer.py",
      "instances": "max",
      "autorestart": false
    }
  ],
  "deploy": {
    "production": { "user": "acme", "host": ["example.invalid"] }
  }
}
