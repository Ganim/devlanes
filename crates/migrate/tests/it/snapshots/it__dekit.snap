---
source: crates/migrate/tests/it/main.rs
expression: report(&migration)
---
# yaml-language-server: $schema=https://devlanes.run/schema/v1.json
# Generated by `devlanes migrate` from dekit.yaml.
# Comments starting with "migrated from" are notes to review.
# migrated from dekit.yaml: on_idle is not migrated: devlanes runs lifecycle tasks with when:
# migrated from dekit.yaml: kernel is a dekit runner setting; not migrated
# migrated from services/worker.yaml: read as a fragment of dekit.yaml
# migrated from dekit.yaml: task report runs scripts/report.js on dekit's JavaScript runtime; not migrated
project: dekit
services:
  # migrated from dekit.yaml: starts with the lane: migrate, api, jobs/worker depend on it
  db:
    run:
      - postgres
      - "-D"
      - .data/db
    env:
      RUST_LOG: info
    ready:
      log: "ready to accept connections \\(port 5432\\)"
    stop:
      timeout: 15s
  # Acme API
  # migrated from dekit.yaml: autorestart: on-failure is not migrated: devlanes does not restart processes that exit
  # migrated from dekit.yaml: deps (db) are not migrated: devlanes starts services together
  # migrated from dekit.yaml: port 3000 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  api:
    run:
      - cargo
      - run
      - "-p"
      - api
    tags:
      - api
    ready:
      http:
        path: /health
      timeout: 30s
    stop:
      timeout: 15s
  logs:
    run: tail -f 'var/log/api server.log'
    env:
      RUST_LOG: info
    autostart: false
    stop:
      timeout: 15s
  # migrated from dekit.yaml: stop keys <C-d> are not migrated: devlanes stops a service with a signal
  repl:
    run: node
    env:
      RUST_LOG: info
    autostart: false
    stop:
      timeout: 15s
  # migrated from dekit.yaml: stop group: false is not migrated: devlanes stops the whole process tree
  # migrated from dekit.yaml: ready interval is not migrated: devlanes picks its own retry interval
  # migrated from dekit.yaml: port 6380 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  cache:
    run: redis-server --port ${{ self.port }}
    env:
      RUST_LOG: info
    autostart: false
    ready:
      tcp: true
    stop:
      signal: SIGINT
      timeout: 20s
  # migrated from dekit.yaml: ready interval is not migrated: devlanes picks its own retry interval
  # migrated from dekit.yaml: fixed local ports remain (8000); they are the same in every lane
  docs:
    run: mkdocs serve
    env:
      RUST_LOG: info
    autostart: false
    ready:
      cmd: curl -fsS http://localhost:8000
    stop:
      timeout: 15s
  assets:
    run:
      - npm
      - run
      - watch
    cwd: web
    env:
      RUST_LOG: info
    autostart: false
    ready:
      cmd: test -e dist/manifest.json
    stop:
      timeout: 15s
  # migrated from services/worker.yaml: renamed from "jobs/worker"
  # migrated from services/worker.yaml: deps (db) are not migrated: devlanes starts services together
  jobs-worker:
    run:
      - node
      - worker.js
    cwd: services
    env:
      RUST_LOG: info
    stop:
      timeout: 15s
tasks:
  # migrated from dekit.yaml: needs db; it runs after the lane's services are ready
  # migrated from dekit.yaml: api waited for it, but start before it now; running db as infra (Compose) lets it run before services
  migrate:
    run:
      - ./migrate.sh
    env:
      RUST_LOG: info
    when: lane.start
    after: services

