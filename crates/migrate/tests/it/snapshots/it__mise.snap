# yaml-language-server: $schema=https://devlanes.run/schema/v1.json
# Generated by `devlanes migrate` from mise.toml, mise-tasks/.
# Comments starting with "migrated from" are notes to review.
# migrated from mise.toml: [env] is not copied: devlanes adds the mise environment to every unit itself
project: mise
tasks:
  # Build the web app
  # migrated from mise.toml: sources is not migrated: devlanes runs the task every time
  # migrated from mise.toml: outputs is not migrated: devlanes runs the task every time
  build:
    run: vite build
    cwd: web
  ci:
    steps:
      - lint
      - test
  # migrated from mise.toml: run is a shebang script, but devlanes runs run text with sh; move it to a file
  greet:
    run: |-
      #!/usr/bin/env bash
      echo "hello $1"
  lint:
    run: eslint .
  release:
    run: ./scripts/release.sh
    confirm: "Cut a new release?"
  # migrated from mise.toml: depends (build) is not migrated: run those tasks first
  test:
    run: |-
      set -e
      vitest run
      ./scripts/test-e2e.sh
    env:
      CI: "1"
  # migrated from mise-tasks/: renamed from "db:seed"
  db-seed:
    run: ./mise-tasks/db/seed.sh

--- notes ---
mise.toml: [env] is not copied: devlanes adds the mise environment to every unit itself
mise.toml [build]: sources is not migrated: devlanes runs the task every time
mise.toml [build]: outputs is not migrated: devlanes runs the task every time
mise.toml [greet]: run is a shebang script, but devlanes runs run text with sh; move it to a file
mise.toml [test]: depends (build) is not migrated: run those tasks first
mise-tasks/ [db-seed]: renamed from "db:seed"
