---
source: crates/migrate/tests/it/main.rs
expression: report(&migration)
---
# yaml-language-server: $schema=https://devlanes.run/v1/schema.json
# Generated by `devlanes migrate` from mprocs.json.
# Comments starting with "migrated from" are notes to review.
project: mprocs-json
services:
  # migrated from mprocs.json: port 5173 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  web:
    run:
      - npx
      - vite
      - "--port"
      - ${{ self.port }}
  # migrated from mprocs.json: local addresses of other services now use their lane ports: 5173 (web)
  api:
    run: node server.js
    cwd: api
    env:
      API_URL: http://localhost:${{ svc.web.port }}/api
    stop:
      signal: SIGKILL

--- notes ---
mprocs.json [web]: port 5173 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
mprocs.json [api]: local addresses of other services now use their lane ports: 5173 (web)
