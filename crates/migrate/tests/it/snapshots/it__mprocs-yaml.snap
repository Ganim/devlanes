# yaml-language-server: $schema=https://devlanes.run/v1/schema.json
# Generated by `devlanes migrate` from mprocs.yaml.
# Comments starting with "migrated from" are notes to review.
# migrated from mprocs.yaml: procs.watcher.shell uses $select; took the macos value
# migrated from mprocs.yaml: procs.watcher.env.TEXT uses $select; took the macos value
# migrated from mprocs.yaml: hide_keymap_window is an mprocs UI setting; not migrated
# migrated from mprocs.yaml: scrollback is an mprocs UI setting; not migrated
project: mprocs-yaml
services:
  nvim:
    run:
      - nvim
    autostart: false
  # migrated from mprocs.yaml: port 3000 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  server:
    run: nodemon server.js
  webpack:
    run: webpack serve
  # migrated from mprocs.yaml: env CI is unset in the source; devlanes cannot remove an inherited variable
  tests:
    run: jest -w
    env:
      NODE_ENV: test
  # migrated from mprocs.yaml: renamed from "API Server"
  # migrated from mprocs.yaml: add_path became PATH; it replaces the PATH devlanes builds (including mise tools), so check it
  # migrated from mprocs.yaml: autorestart is not migrated: devlanes does not restart processes that exit
  # migrated from mprocs.yaml: deps (db) are not migrated: devlanes starts services together
  # migrated from mprocs.yaml: log is not migrated: devlanes keeps every service's output
  # migrated from mprocs.yaml: port 8080 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  api-server:
    run:
      - cargo
      - run
      - "-p"
      - acme-api
      - "--"
      - "--port"
      - ${{ self.port }}
    cwd: api
    env:
      PATH: ./bin:${{ env.PATH }}
    stop:
      signal: SIGINT
  # migrated from mprocs.yaml: stop sends SIGINT instead of typing <C-c>
  db:
    run: postgres -D .data/db
    stop:
      signal: SIGINT
  # migrated from mprocs.yaml: stop command "docker compose stop rabbitmq" is not migrated: devlanes stops a service with a signal
  queue:
    run: docker compose up rabbitmq
  # migrated from mprocs.yaml: procs.watcher.priority is not migrated
  watcher:
    run: npm run watch
    env:
      TEXT: Macos

