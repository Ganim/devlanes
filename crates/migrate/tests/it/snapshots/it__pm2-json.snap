---
source: crates/migrate/tests/it/main.rs
expression: report(&migration)
---
# yaml-language-server: $schema=https://devlanes.run/v1/schema.json
# Generated by `devlanes migrate` from ecosystem.config.json.
# Comments starting with "migrated from" are notes to review.
# migrated from ecosystem.config.json: deploy is for servers; not migrated
project: pm2-json
services:
  # migrated from ecosystem.config.json: cluster mode shared one port between instances; devlanes gives each replica its own port
  # migrated from ecosystem.config.json: watch is not migrated: devlanes does not restart on file changes
  # migrated from ecosystem.config.json: env_production (pm2 --env) not migrated; use a devlanes profile with env
  # migrated from ecosystem.config.json: out_file not migrated: devlanes keeps every service's output
  # migrated from ecosystem.config.json: max_memory_restart not migrated: devlanes does not restart processes
  # migrated from ecosystem.config.json: port 4000 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  # migrated from ecosystem.config.json: local addresses of other services now use their lane ports: 5173 (web)
  api:
    run: node --inspect ./api/server.js --port ${{ self.port }}
    env:
      NODE_ENV: development
      WEB_URL: http://localhost:${{ svc.web.port }}
    replicas: 2
    stop:
      signal: SIGINT
      timeout: 3s
  # migrated from ecosystem.config.json: wait_ready/listen_timeout are not migrated; add a ready check
  # migrated from ecosystem.config.json: port 5173 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  web:
    run: npm run dev -- --port ${{ self.port }}
    cwd: web
    stop:
      signal: SIGINT
  # migrated from ecosystem.config.json: instances: max is not migrated; set replicas
  mailer:
    run: python workers/mailer.py
    stop:
      signal: SIGINT

--- notes ---
ecosystem.config.json: deploy is for servers; not migrated
