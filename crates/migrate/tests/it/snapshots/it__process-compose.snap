---
source: crates/migrate/tests/it/main.rs
expression: report(&migration)
---
# yaml-language-server: $schema=https://devlanes.run/v1/schema.json
# Generated by `devlanes migrate` from process-compose.yaml, process-compose.override.yaml.
# Comments starting with "migrated from" are notes to review.
# migrated from process-compose.override.yaml: merged over process-compose.yaml
# migrated from process-compose.yaml: process-compose loads .env into every process; devlanes reads it only for ${{ env.NAME }} expressions, so add what processes need to global_env as NAME: ${{ env.NAME }}, or `dotenv` to .envrc (.env defines ACME_MODE)
# migrated from process-compose.yaml: environment DATA_DIR: $VAR became ${{ env.VAR }}, read from the shell that runs devlanes or from .env
project: process-compose
global_env:
  LOG_LEVEL: debug
  DATA_DIR: ${{ env.HOME }}/.acme
services:
  db:
    run: postgres -D .data/db
    ready:
      log: ready to accept connections
    stop:
      signal: SIGINT
      timeout: 20s
  # migrated from process-compose.yaml: environment UPSTREAM uses an expansion function devlanes does not have; fill it in
  # migrated from process-compose.yaml: availability.restart: on_failure is not migrated: devlanes does not restart processes that exit
  # migrated from process-compose.yaml: liveness_probe is not migrated: devlanes checks readiness only while starting
  # migrated from process-compose.yaml: depends_on (db) is not migrated: devlanes starts services together
  # migrated from process-compose.yaml: readiness_probe timing (initial_delay_seconds, period_seconds) is not migrated; devlanes retries until ready.timeout
  # migrated from process-compose.yaml: port 8080 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  # migrated from process-compose.yaml: fixed local ports remain (5432); they are the same in every lane
  api:
    run: go run ./cmd/api --port ${{ self.port }}
    cwd: services/api
    env:
      DB_URL: postgres://localhost:5432/acme
      UPSTREAM: "${UPSTREAM_URL^^}"
    tags:
      - backend
    ready:
      http:
        path: /health
  # migrated from process-compose.yaml: replicas: PC_REPLICA_NUM counted from 0; devlanes has ${{ replica.index }} from 1
  # migrated from process-compose.yaml: port 5173 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  # migrated from process-compose.yaml: local addresses of other services now use their lane ports: 8080 (api)
  web:
    run: npm run dev -- --port ${{ self.port }}
    cwd: web
    env:
      API_URL: http://localhost:${{ svc.api.port }}
      VITE_MODE: development
    replicas: 2
    tags:
      - frontend
    ready:
      cmd: curl -fsS http://localhost:${{ self.port }}
  # migrated from process-compose.yaml: env_file .env.worker is not migrated: devlanes does not read env files
  # migrated from process-compose.yaml: shutdown.command "./worker --drain" is not migrated: devlanes stops a service with a signal
  worker:
    run: "echo started $HOSTNAME && ./worker"
    autostart: false
  # migrated from process-compose.yaml: is_daemon is not migrated: devlanes runs the command in the foreground and stops it with a signal
  # migrated from process-compose.yaml: processes.nginx.log_location is not migrated
  nginx:
    run: docker run -d --rm --name acme_nginx nginx
tasks:
  # migrated from process-compose.yaml: needs db; it runs after the lane's services are ready
  # migrated from process-compose.yaml: api waited for it, but start before it now; running db as infra (Compose) lets it run before services
  migrate:
    run: ./scripts/migrate.sh
    when: lane.start
    after: services
  # migrated from process-compose.yaml: exit_on_end became an on-demand task: run it with devlanes run, or devlanes with
  e2e:
    run: npx playwright test
  # migrated from process-compose.yaml: is_foreground became an interactive task: run it with devlanes run
  shell:
    run: psql acme
    interactive: true

--- notes ---
