# yaml-language-server: $schema=https://devlanes.run/v1/schema.json
# Generated by `devlanes migrate` from Procfile, .foreman.
# Comments starting with "migrated from" are notes to review.
# migrated from .foreman: port=5000 is not migrated: devlanes gives each service a port per lane
project: procfile-foreman
services:
  web:
    run: bundle exec puma -p $PORT
    replicas: 2
  clock:
    run: bundle exec clockwork clock.rb
    autostart: false
tasks:
  # migrated from Procfile: Heroku runs release when deploying; it became an on-demand task
  release:
    run: bin/rails db:migrate
# migrated from docker-compose.yml: to run its containers as shared infra (one set for all lanes), uncomment:
# infra:
#   compose: docker-compose.yml

--- notes ---
.foreman: port=5000 is not migrated: devlanes gives each service a port per lane
Procfile [release]: Heroku runs release when deploying; it became an on-demand task
docker-compose.yml: not migrated; the file ends with a commented infra.compose to run its containers as shared infra
