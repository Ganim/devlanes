# yaml-language-server: $schema=https://devlanes.run/schema/v1.json
# Generated by `devlanes migrate` from Procfile.dev, .overmind.env.
# Comments starting with "migrated from" are notes to review.
# migrated from Procfile: skipped: Procfile.dev is the development one; Procfile is usually for production
# migrated from .overmind.env: OVERMIND_AUTO_RESTART=worker is not migrated: devlanes does not restart processes that exit
# migrated from .overmind.env: OVERMIND_PORT=3000 is not migrated: devlanes gives each service a port per lane
# migrated from Procfile.dev: line "not a process line" is not a process; skipped
project: procfile-overmind
services:
  web:
    run: bin/rails server -p $PORT -b 127.0.0.1
  css:
    run: bin/rails tailwindcss:watch
  worker:
    run: bundle exec sidekiq -C config/sidekiq.yml
    replicas: 2
  # migrated from Procfile.dev: OVERMIND_PROCESS_*_PORT now reads the lane port of web
  proxy:
    run: ngrok http --url acme.example.invalid ${{ svc.web.port }}
  mail:
    run: mailcatcher --foreground --http-port 1080
    autostart: false
tasks:
  # migrated from Procfile.dev: OVERMIND_CAN_DIE: it runs once on every lane start
  npm_install:
    run: npm install
    when: lane.start

