---
source: crates/migrate/tests/it/main.rs
expression: report(&migration)
---
# yaml-language-server: $schema=https://devlanes.run/schema/v1.json
# Generated by `devlanes migrate` from .tmuxinator.yml.
# Comments starting with "migrated from" are notes to review.
# migrated from .tmuxinator.yml: pre_window runs before every pane's commands
# migrated from .tmuxinator.yml: on_project_exit has no devlanes lifecycle hook; not migrated
# migrated from .tmuxinator.yml: window editor: pane "vim" needs a terminal; not migrated
# migrated from .tmuxinator.yml: window elsewhere: working directory not migrated: /srv/acme-other is outside the project; every lane runs in its own worktree
project: tmuxinator
services:
  editor:
    run: |-
      export RAILS_ENV=development
      guard
  # migrated from .tmuxinator.yml: port 3000 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  server:
    run: |-
      export RAILS_ENV=development
      bundle exec rails s -p ${{ self.port }}
  logs:
    run: |-
      export RAILS_ENV=development
      tail -f log/development.log
  frontend-dev:
    run: |-
      export RAILS_ENV=development
      cd src
      npm run dev
    cwd: web
  frontend-2:
    run: |-
      export RAILS_ENV=development
      npm run test -- --watch
    cwd: web
  elsewhere:
    run: |-
      export RAILS_ENV=development
      ./run.sh
tasks:
  on-project-start:
    run: docker compose up -d postgres
    when: lane.start
  on-project-first-start:
    run: bin/setup
    when: lane.create
  on-project-stop:
    run: docker compose stop
    when: lane.stop

--- notes ---
.tmuxinator.yml: pre_window runs before every pane's commands
.tmuxinator.yml: on_project_exit has no devlanes lifecycle hook; not migrated
.tmuxinator.yml: window editor: pane "vim" needs a terminal; not migrated
.tmuxinator.yml: window elsewhere: working directory not migrated: /srv/acme-other is outside the project; every lane runs in its own worktree
.tmuxinator.yml [server]: port 3000 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
