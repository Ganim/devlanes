source: crates/migrate/tests/it/main.rs
expression: report(&migration)
---
# yaml-language-server: $schema=https://devlanes.run/schema/v1.json
# Generated by `devlanes migrate` from .tmuxp.yaml.
# Comments starting with "migrated from" are notes to review.
# migrated from .tmuxp.yaml: window backend: pane "nvim" needs a terminal; not migrated
# migrated from .tmuxp.yaml: window misc: pane "htop" needs a terminal; not migrated
project: tmuxp-yaml
global_env:
  DJANGO_SETTINGS_MODULE: acme.settings.dev
services:
  # migrated from .tmuxp.yaml: port 8000 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
  backend-1:
    run: |-
      . .venv/bin/activate
      python manage.py runserver 127.0.0.1:${{ self.port }}
    env:
      DEBUG: "1"
  backend-2:
    run: |-
      . .venv/bin/activate
      celery -A acme worker
    cwd: worker
    env:
      DEBUG: "1"
  frontend:
    run: |-
      . .venv/bin/activate
      npm run dev
    cwd: frontend
tasks:
  before-script:
    run: ./bootstrap.sh
    when: lane.start

--- notes ---
.tmuxp.yaml: window backend: pane "nvim" needs a terminal; not migrated
.tmuxp.yaml: window misc: pane "htop" needs a terminal; not migrated
.tmuxp.yaml [backend-1]: port 8000 is now the lane's port (${{ self.port }}, also in PORT), so lanes do not collide
